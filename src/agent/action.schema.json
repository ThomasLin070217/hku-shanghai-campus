{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HKU Campus Action v2.0",
  "description": "Legacy camera-relative input (1-1000 ms) or a semantic directive executed over fixed steps (1-30000 ms). Both run through the same character physics; no coordinate writes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "commandId",
    "controlEpoch",
    "durationMs"
  ],
  "properties": {
    "commandId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_.:-]{1,80}$"
    },
    "controlEpoch": {
      "type": "integer",
      "minimum": 0
    },
    "durationMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30000,
      "description": "1-1000 without directive; 1-30000 with directive"
    },
    "move": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forward",
        "right"
      ],
      "properties": {
        "forward": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "right": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "lookDelta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "yawDeg",
        "pitchDeg"
      ],
      "properties": {
        "yawDeg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "pitchDeg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "sprint": {
      "type": "boolean"
    },
    "jump": {
      "type": "boolean"
    },
    "switchView": {
      "type": "boolean"
    },
    "selectHotbar": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "interact": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,80}$"
    },
    "computer": {
      "enum": [
        "map",
        "tasks",
        "clues",
        "submit"
      ]
    },
    "directive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "walkTo",
            "approach",
            "lookAt",
            "followPath"
          ]
        },
        "position": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 3
        },
        "entityId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
          "description": "Stable ID from observation.landmarks (B01-B07, survey records, signs)"
        },
        "toleranceM": {
          "type": "number",
          "minimum": 0.05,
          "maximum": 10
        },
        "stopDistanceM": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 20
        },
        "toleranceDeg": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 90
        },
        "sprint": {
          "type": "boolean"
        },
        "path": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 2,
            "maxItems": 3
          }
        }
      }
    }
  }
}
