# Copy to .env and fill in privately. .env is gitignored; never commit keys.
# scripts/llm.mjs talks to either provider:
#   gemini  - Google Gemini API directly (GEMINI_*)
#   litellm - OpenAI-compatible LiteLLM proxy (LITELLM_*)
# Pick one with LLM_PROVIDER; when unset, a Gemini key selects gemini, else litellm.

# Optional: gemini | litellm. Unset = auto (gemini when GEMINI_API_KEY exists).
# LLM_PROVIDER=gemini

# --- Gemini (Google AI Studio) ---
# API key from https://aistudio.google.com/apikey. Never paste it in chat or commit it.
GEMINI_API_KEY=

# Model id as listed by `npm run llm -- --models --provider gemini`.
GEMINI_MODEL=gemini-3.8-flash

# Optional: API root. Default https://generativelanguage.googleapis.com/v1beta.
# Point it at your own gateway when the Gemini API is unavailable from your network.
# GEMINI_BASE_URL=

# Optional: native (default, generateContent) or openai (OpenAI-compatible /openai/chat/completions).
# GEMINI_TRANSPORT=native

# --- LiteLLM proxy ---
# Proxy root, e.g. https://your-litellm-host (or https://your-litellm-host/v1).
# A full .../chat/completions URL is also accepted as-is.
LITELLM_BASE_URL=

# Virtual key from the LiteLLM dashboard. Never paste it in chat or commit it.
LITELLM_API_KEY=

# Default model name exactly as the proxy lists it (see: npm run llm -- --models).
LITELLM_MODEL=

# Optional: request timeout in ms for either provider, default 60000.
# LLM_TIMEOUT_MS=60000
# LITELLM_TIMEOUT_MS=60000
# GEMINI_TIMEOUT_MS=60000

# Optional: World Labs key for `npm run ai:atlas` (unrelated to the LLM client).
# WLT_API_KEY=
