# Copy to .env and fill in privately. .env is gitignored; never commit keys.
# scripts/llm.mjs talks to one of three providers:
#   deepseek - DeepSeek platform API, OpenAI-compatible (DEEPSEEK_*)
#   gemini   - Google Gemini API directly (GEMINI_*)
#   litellm  - OpenAI-compatible LiteLLM proxy (LITELLM_*)
# Pick one with LLM_PROVIDER; when unset a DeepSeek key wins, then Gemini, else LiteLLM.

# Optional: deepseek | gemini | litellm. Unset = auto (deepseek, then gemini, then litellm).
# LLM_PROVIDER=deepseek

# --- DeepSeek platform ---
# Key from https://platform.deepseek.com. Used by the MacBook AI bridge by default.
# Never paste it in chat or commit it.
DEEPSEEK_API_KEY=

# Model id as listed by `npm run llm -- --models --provider deepseek`.
# 2026-11-21: deepseek-flash (fast, used for in-game chat) and deepseek-v4-pro.
DEEPSEEK_MODEL=deepseek-flash

# Optional: API root. Default https://api.deepseek.com (OpenAI-compatible).
# DEEPSEEK_BASE_URL=

# Optional: force the in-game bridge provider. Default: DEEPSEEK_API_KEY -> deepseek,
# else scripts/llm.mjs's default provider.
# HKU_LLM_PROVIDER=deepseek

# --- Gemini (Google AI Studio) ---
# API key from https://aistudio.google.com/apikey. Never paste it in chat or commit it.
GEMINI_API_KEY=

# Model id as listed by `npm run llm -- --models --provider gemini`.
# gemini-3.8-flash is newest but was returning 503 (high demand) on 2026-11-21;
# gemini-3.1-flash-lite was the stable choice.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional: API root. Default https://generativelanguage.googleapis.com/v1beta.
# Point it at your own gateway when the Gemini API is unavailable from your network.
# GEMINI_BASE_URL=

# Optional: native (default, generateContent) or openai (OpenAI-compatible /openai/chat/completions).
# GEMINI_TRANSPORT=native

# Optional: port for the local MacBook AI bridge started by `npm run play`.
# HKU_LLM_PORT=8790

# Optional: outbound HTTP(S) proxy for API calls, e.g. a local Clash/mihomo port.
# Wins over HTTPS_PROXY. Node 24+; applies to the `npm run llm` CLI (it restarts
# itself with NODE_USE_ENV_PROXY=1). SOCKS proxies are not supported.
# LLM_PROXY=http://127.0.0.1:7897

# --- LiteLLM proxy ---
# The LiteLLM proxy accepts the OpenAI API format, so any OpenAI-compatible client works.
# Proxy root, e.g. https://your-litellm-host (or https://your-litellm-host/v1).
# A full .../chat/completions URL is also accepted as-is.
LITELLM_BASE_URL=

# Virtual key from the LiteLLM dashboard. Never paste it in chat or commit it.
# May stay empty when LITELLM_BASE_URL is a loopback (127.0.0.1 / localhost)
# OpenAI-compatible server that needs no auth, e.g. llama.cpp or Ollama /v1.
LITELLM_API_KEY=

# Default model name exactly as the proxy lists it (see: npm run llm -- --models).
LITELLM_MODEL=

# Optional: request timeout in ms for either provider, default 60000.
# LLM_TIMEOUT_MS=60000
# LITELLM_TIMEOUT_MS=60000
# GEMINI_TIMEOUT_MS=60000
# DEEPSEEK_TIMEOUT_MS=60000

# Optional: World Labs key for `npm run ai:atlas` (unrelated to the LLM client).
# WLT_API_KEY=
