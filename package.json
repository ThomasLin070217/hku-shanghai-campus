{
  "name": "hku-shanghai-whole-campus",
  "version": "9.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "export:glb": "tsx scripts/export-model.ts",
    "validate:glb": "node scripts/validate-glb.mjs",
    "check:geometry": "tsx scripts/check-campus.ts",
    "check:exploration": "tsx scripts/check-exploration.ts",
    "play": "node scripts/start.mjs",
    "agent:server": "node scripts/agent-server.mjs",
    "agent:demo": "node scripts/agent-demo.mjs",
    "check:v4": "tsx scripts/check-v4.ts",
    "check:video": "tsx scripts/check-video-details.ts",
    "check:gameplay": "tsx scripts/check-gameplay.ts",
    "check:transport": "node scripts/check-agent-transport.mjs",
    "ai:atlas": "tsx scripts/atlas-campus.ts",
    "check:v8": "tsx scripts/check-v8.ts",
    "check:nov13": "tsx scripts/check-nov13.ts",
    "export:v8": "tsx scripts/export-v8.ts",
    "check:all": "npm run check:exploration && npm run check:v4 && npm run check:video && npm run check:gameplay && npm run check:v8 && npm run check:nov13 && npm run check:scale && npm run check:glass && npm run check:survey && npm run check:experience && npm run check:nov14 && npm run check:review && npm run check:audio-review && npm run check:remaining && npm run check:sign-roads && npm run build",
    "check:scale": "tsx scripts/check-scale-calibration.ts",
    "check:glass": "tsx scripts/check-glass.ts",
    "check:survey": "tsx scripts/check-survey.ts",
    "check:experience": "tsx scripts/check-experience-fix.ts",
    "check:nov14": "tsx scripts/check-nov14-video.ts",
    "build:review": "tsc --noEmit && vite build --mode review",
    "check:review": "tsx scripts/check-workbuddy.ts",
    "typecheck": "tsc --noEmit",
    "check:audio-review": "tsx scripts/check-audio-review.ts",
    "check:remaining": "tsx scripts/check-remaining.ts",
    "check:sign-roads": "tsx scripts/check-sign-roads.ts",
    "ai:depth": "tsx scripts/export-atlas-depth.ts"
  },
  "dependencies": {
    "@sparkjsdev/spark": "2.4.0",
    "three": "0.181.2",
    "ws": "^8.23.0",
    "xstate": "5.33.4"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.1",
    "@types/node": "^24.0.0",
    "@types/three": "0.181.0",
    "@types/ws": "^8.18.2",
    "@worldlabsai/client": "0.7.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  }
}
